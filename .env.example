# Copy to .env (git-ignored) and fill in what you have. Every key is optional;
# sources that need a missing key are skipped with a message.

# Where downloaded data lives. Defaults to ./data inside the repo.
# Tip: point this outside OneDrive/Dropbox so large files don't sync.
# ALAMEDA_DATA_DIR=C:\Users\you\alameda-traffic-data

# https://api.census.gov/data/key_signup.html  (without it, ACS falls back to
# streaming the Census table-based summary files, ~450 MB)
CENSUS_API_KEY=

# https://api.actransit.org/transit/Help  (AC Transit GTFS)
ACTRANSIT_TOKEN=

# https://511.org/open-data/token  (regional GTFS, all Bay Area operators)
API_511_KEY=

# https://www.mapillary.com/dashboard/developers  (traffic-sign detections)
MAPILLARY_TOKEN=
